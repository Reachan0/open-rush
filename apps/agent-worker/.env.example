# Default runtime is DeepSeek Harness. Set AGENT_RUNTIME=claude-code to fall back.
AGENT_RUNTIME=dsh

# DeepSeek Harness (OpenAI-compatible chat completions)
DEEPSEEK_API_KEY=xxx
# Private gateway example: https://host:port/aigw/v1  (runtime appends /chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=DeepSeek-V4-Flash-INT8
# Set to 0 only for a self-signed / private TLS gateway (equivalent to curl -k)
# NODE_TLS_REJECT_UNAUTHORIZED=0
# DSH_PROVIDER=deepseek-official
# Optional. Defaults to a sibling checkout: ../deepseek-harness
# DSH_ROOT=../deepseek-harness
# DSH_RUNTIME_BIN=
# DSH_CORDIS_CONFIG=

# Legacy Claude Code fallback
# AGENT_RUNTIME=claude-code
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_API_KEY=xxx
# CLAUDE_MODEL=glm-4.7
# ANTHROPIC_MODEL=sonnet

# Keenable web.search (optional). Without a key, /v1/search/public is used.
# KEENABLE_API_KEY=keen_...
# KEENABLE_API_URL=https://api.keenable.ai
# KEENABLE_TITLE=OpenRush

# Amap Maps MCP (optional). With a key, the fast lane uses official Amap tools
# instead of travel mocks. Put the real key in .env.local, never commit it.
# AMAP_MAPS_API_KEY=

# Coding Tools MCP (https://github.com/xyTom/coding-tools-mcp). Default on.
# Set to 0 to skip. Workspace is the current project path. Permission: safe|trusted|dangerous.
# CODING_TOOLS_MCP=1
# CODING_TOOLS_MCP_PERMISSION_MODE=safe
# Optional workspace root for coding-tools / fs.read. Default: walk up to pnpm-workspace.yaml or .git
# WORKFLOW_WORKSPACE=

# Server
# PORT=8787
