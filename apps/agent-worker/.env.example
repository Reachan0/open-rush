# Default runtime is DeepSeek Harness. Set AGENT_RUNTIME=claude-code to fall back.
AGENT_RUNTIME=dsh

# DeepSeek Harness (OpenAI-compatible chat completions)
DEEPSEEK_API_KEY=xxx
# Private gateway example: https://host:port/aigw/v1  (runtime appends /chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=DeepSeek-V4-Flash-INT8
# Set to 0 only for a self-signed / private TLS gateway (equivalent to curl -k)
# NODE_TLS_REJECT_UNAUTHORIZED=0
# DSH_PROVIDER=deepseek-official
# Optional. Defaults to a sibling checkout: ../deepseek-harness
# DSH_ROOT=../deepseek-harness
# DSH_RUNTIME_BIN=
# DSH_CORDIS_CONFIG=
# Optional thinking effort for the DSH child: off | low | high | max (default high, not max).
# DSH_REASONING_EFFORT=high

# Legacy Claude Code fallback
# AGENT_RUNTIME=claude-code
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_API_KEY=xxx
# CLAUDE_MODEL=glm-4.7
# ANTHROPIC_MODEL=sonnet

# Keenable web search MCP (Loop + HTTP catalog). Without a key, /v1/search/public is used.
# Base MUST be an absolute URL. A relative /v1/search makes fetch throw "Failed to parse URL".
# KEENABLE_API_KEY=keen_...
# KEENABLE_API_URL=https://api.keenable.ai
# KEENABLE_BASE_URL=https://api.keenable.ai
# KEENABLE_TITLE=OpenRush

# Amap Maps MCP (Loop + HTTP catalog). Put the real key in .env.local, never commit it.
# AMAP_MAPS_API_KEY=

# Coding Tools MCP (https://github.com/xyTom/coding-tools-mcp). Default off (no npx on chat start).
# Set to 1 to enable (also hangs it onto the DSH Loop).
# CODING_TOOLS_MCP=1
# CODING_TOOLS_MCP_PERMISSION_MODE=safe
# Optional workspace root for DSH glob/read (DSH_CWD) and coding-tools / fs.read.
# Default: walk up to the OpenRush monorepo (pnpm-workspace.yaml), not the empty
# Lux project sandbox at workspace/<projectId>.
# WORKFLOW_WORKSPACE=

# DSH native web_search is denylisted from the fast-lane catalog. Search goes through
# mcp__keenable-search__web_search (this file's KEENABLE_*). Do not point DEEPSEEK_SEARCH_*
# at a private gateway key — that path hits Anthropic /messages and Authentication Fails.
# DEEPSEEK_SEARCH_BASE_URL=

# Server
# PORT=8787
